# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com/project/dldpuhfltblztbiawtxq/settings/api
VITE_SUPABASE_URL=https://dldpuhfltblztbiawtxq.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Edge Function environment variables ────────────────────────────────────
# Set these via: npx supabase secrets set KEY=value
# Or: Supabase Dashboard → Settings → Edge Functions → Secrets
# DO NOT put real values in this file — copy to .env.local instead

# Resend API key for email sending: https://resend.com/api-keys
RESEND_API_KEY=re_...

# The domain your FROM email address uses (must be verified in Resend)
EMAIL_FROM_DOMAIN=yourdomain.com

# Your deployed frontend URL (used for tracking links in emails)
PUBLIC_APP_URL=https://app.yourapp.com
